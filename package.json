{
  "name": "axen-ai",
  "version": "3.0.0",
  "description": "Axen AI — Local-First Personal AI with from-scratch Neural Brain",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --unified",
    "start:node": "node server.js",
    "learning:status": "node server.js --autonomy-status",
    "learning:test": "node server.js --autonomy-test",
    "learning:demo": "node server.js --learning-demo-offline",
    "train": "node ai/brain/train.js 600",
    "train:reviewed": "node ai/brain/train-reviewed.js",
    "test:reverse": "node --test tests/reverse-engineering.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
