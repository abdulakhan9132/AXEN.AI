<script>
window.errors=[]; window.addEventListener('error',e=>errors.push(e.message));
window.addEventListener('unhandledrejection',e=>errors.push(String(e.reason)));
localStorage.clear();localStorage.setItem('aexn_theme','dark');
window.EventSource=class{constructor(){}close(){}};
window.confirm=()=>true; window.testRequests=[];
window.fetch=async(url,options={})=>{
 const route=String(url),request=options.body&&typeof options.body==='string'?JSON.parse(options.body):{};
 testRequests.push({route,request});let data={};
 if(route==='/api/brain')data={trained:true,steps:12};
 if(route==='/api/status')data={status:'ready',model:'Local model',tools:['math_solver','calculator','python','memory']};
 if(route==='/api/autonomy/status')data={status:'stopped',mode:'OFF',goals:[],resources:{available:true},remaining_seconds:0};
 if(route==='/api/sessions')data={sessions:true?[{id:'demo',title:'Differentiate a product',created_at:new Date().toISOString(),message_count:4}]:[],active_session_id:true?'demo':null};
 if(route==='/api/sessions/demo')data={id:'demo',messages:[
  {role:'user',content:'Differentiate f(x)=(2x^3-5x+4)(x^2+3x-1)'},
  {role:'assistant',content:"f'(x) = 10*x**4 + 24*x**3 - 21*x**2 - 22*x + 17",metadata:{selected_tool:'math_solver',verification:{passed:true}}},
  {role:'user',content:'25 * 48'},
  {role:'assistant',content:'1200',metadata:{selected_tool:'calculator',verification:{passed:true}}}]};
 return new Response(JSON.stringify(data),{headers:{'Content-Type':'application/json'}});
};
</script><script>document.documentElement.dataset.theme = localStorage.getItem('aexn_theme') || 'light';</script>
