<div class="shell" id="shell">
<aside class="glass side" aria-label="Sidebar">
  <div class="brand"><span class="logo"><i></i><i></i><i></i></span>AEXN AI</div>
  <button class="new" id="newChat"><svg class="i"><use href="#edit"/></svg>New chat</button>
  <nav class="nav" aria-label="Sections">
    <button class="on"><svg class="i"><use href="#chat"/></svg>Chats</button>
    <button><svg class="i"><use href="#folder"/></svg>Projects<span class="add" title="New project"><svg class="i" style="width:15px;height:15px"><use href="#plus"/></svg></span></button>
    <button><svg class="i"><use href="#file"/></svg>Files</button>
    <button><svg class="i"><use href="#book"/></svg>Knowledge</button>
    <button><svg class="i"><use href="#mem"/></svg>Memory</button>
    <button><svg class="i"><use href="#brain"/></svg>Brain</button>
    <button><svg class="i"><use href="#evo"/></svg>Evolution</button>
  </nav>
  <div class="grp">Today</div>
  <button class="chat on"><span>Greatest common divisor</span></button>
  <button class="chat"><span>Differentiate a product</span></button>
  <div class="grp">Yesterday</div>
  <button class="chat"><span>Quick greeting</span></button>
  <button class="chat"><span>Calculator checks</span></button>
  <div class="status"><span class="dot"></span>Running locally on this device</div>
</aside>

<main class="glass main chatting" id="main">
  <div class="top">
    <div class="title" id="ttl">Differentiate a product</div>
    <span class="sp"></span>
    <button class="pill" id="panel" aria-label="Toggle details panel"><svg class="i"><use href="#panel"/></svg>Details</button>
    <button class="pill" id="theme">Theme</button>
  </div>
  <div class="scroll"><div class="wrap">
    <div class="hero">
      <h1>What would you like to work on today?</h1>
      <div id="slotTop"></div>
      <div class="chips">
        <button class="chip"><svg class="i"><use href="#img"/></svg>Create image</button>
        <button class="chip"><svg class="i"><use href="#bars"/></svg>Solve math</button>
        <button class="chip"><svg class="i"><use href="#file"/></svg>Summarize text</button>
        <button class="chip"><svg class="i"><use href="#code"/></svg>Reverse engineer</button>
      </div>
      <div class="cards">
        <button class="card"><b>Write an email</b><span>Professional tone</span><svg class="i"><use href="#mail"/></svg></button>
        <button class="card"><b>Analyze data</b><span>CSV, Excel, JSON</span><svg class="i"><use href="#bars"/></svg></button>
        <button class="card"><b>Explain anything</b><span>In simple terms</span><svg class="i"><use href="#help"/></svg></button>
        <button class="card"><b>Code something</b><span>Python, JS, HTML</span><svg class="i"><use href="#code"/></svg></button>
      </div>
    </div>
    <div class="convo" id="convo">
      <div class="u">Differentiate f(x)=(2x^3-5x+4)(x^2+3x-1)</div>
      <div class="a"><div class="av"><span class="logo"><i></i><i></i><i></i></span></div><div>
        <span class="badge" title="Checked with a symbolic solver">&#10003; Math Solver verified</span><span class="meta">Product rule</span>
        <div class="res">
          <div class="math q">Differentiate <i>f</i>(<i>x</i>) = (2<i>x</i><sup>3</sup> &minus; 5<i>x</i> + 4)(<i>x</i><sup>2</sup> + 3<i>x</i> &minus; 1)</div>
          <div class="math big"><i>f</i>&prime;(<i>x</i>) = 10<i>x</i><sup>4</sup> + 24<i>x</i><sup>3</sup> &minus; 21<i>x</i><sup>2</sup> &minus; 22<i>x</i> + 17</div>
        </div>
        <details><summary>Show steps</summary><div class="steps">
          <div class="math">Let <i>u</i> = 2<i>x</i><sup>3</sup> &minus; 5<i>x</i> + 4 and <i>v</i> = <i>x</i><sup>2</sup> + 3<i>x</i> &minus; 1</div>
          <div class="math"><i>u</i>&prime; = 6<i>x</i><sup>2</sup> &minus; 5, &nbsp; <i>v</i>&prime; = 2<i>x</i> + 3</div>
          <div class="math"><i>f</i>&prime; = <i>u</i>&prime;<i>v</i> + <i>u</i><i>v</i>&prime;</div>
          <div class="math">= (6<i>x</i><sup>4</sup> + 18<i>x</i><sup>3</sup> &minus; 11<i>x</i><sup>2</sup> &minus; 15<i>x</i> + 5) + (4<i>x</i><sup>4</sup> + 6<i>x</i><sup>3</sup> &minus; 10<i>x</i><sup>2</sup> &minus; 7<i>x</i> + 12)</div>
        </div></details>
        <div class="acts"><button class="ibtn" aria-label="Copy"><svg><use href="#copy"/></svg></button><button class="ibtn" aria-label="Good answer"><svg><use href="#up"/></svg></button><button class="ibtn" aria-label="Bad answer"><svg style="transform:scaleY(-1)"><use href="#up"/></svg></button></div>
      </div></div>
      <div class="u">25 * 48</div>
      <div class="a"><div class="av"><span class="logo"><i></i><i></i><i></i></span></div><div>
        <span class="badge">&#10003; Calculator verified</span>
        <div class="res"><div class="math q">25 &times; 48</div><div class="math big">1,200</div></div>
        <div class="acts"><button class="ibtn" aria-label="Copy"><svg><use href="#copy"/></svg></button><button class="ibtn" aria-label="Good answer"><svg><use href="#up"/></svg></button><button class="ibtn" aria-label="Bad answer"><svg style="transform:scaleY(-1)"><use href="#up"/></svg></button></div>
      </div></div>
    </div>
  </div></div>
  <div class="dock"><div class="wrap" id="slotBottom">
    <div class="comp" id="comp">
      <textarea id="msg" aria-label="Message" placeholder="Message AEXN AI"></textarea>
      <div class="crow">
        <button class="ibtn" aria-label="Attach file"><svg class="i"><use href="#clip"/></svg></button>
        <button class="mode"><svg class="i" style="width:15px;height:15px"><use href="#tool"/></svg>Tools</button>
        <button class="mode">Auto</button>
        <span class="sp"></span>
        <button class="ibtn" aria-label="Voice input"><svg class="i"><use href="#mic"/></svg></button>
        <button class="send" id="send" aria-label="Send"><svg class="i"><use href="#send"/></svg></button>
      </div>
    </div>
    <div class="hint">Enter to send &middot; Shift+Enter for a new line</div>
  </div></div>
</main>

<aside class="right" aria-label="Details">
  <section class="glass box"><h3>Local model</h3><p>Runs on your machine with Ollama. Your chats never leave this device.</p></section>
  <section class="glass box"><h3>Capabilities</h3>
    <div class="row">Math Solver <span class="ok">On</span></div><div class="row">Calculator <span class="ok">On</span></div><div class="row">Code runner <span class="ok">On</span></div><div class="row">Memory <span class="ok">On</span></div><div class="row">Image generation <span class="off">Off</span></div></section>
  <section class="glass box"><h3>Your activity</h3><div class="stat">Messages sent <b>128</b></div><div class="stat">Verified answers <b>94</b></div><div class="stat">Time saved <b>3h 20m</b></div></section>
</aside>
</div>
<script>
(function(){
var r=document.documentElement,main=document.getElementById('main'),comp=document.getElementById('comp'),
 top=document.getElementById('slotTop'),bot=document.getElementById('slotBottom'),convo=document.getElementById('convo'),
 msg=document.getElementById('msg'),ttl=document.getElementById('ttl'),shell=document.getElementById('shell'),hint=bot.querySelector('.hint');
function view(v){main.className='glass main '+v;if(v==='empty'){top.appendChild(comp);hint.style.display='none';ttl.textContent='New chat'}else{bot.insertBefore(comp,hint);hint.style.display=''}}
function setOn(el){document.querySelectorAll('.chat').forEach(function(c){c.classList.remove('on')});if(el)el.classList.add('on')}
document.getElementById('newChat').onclick=function(){view('empty');setOn(null);msg.focus()};
document.querySelectorAll('.chat').forEach(function(c){c.onclick=function(){view('chatting');setOn(c);ttl.textContent=c.textContent}});
function send(){var t=msg.value.trim();if(!t)return;view('chatting');var d=document.createElement('div');d.className='u';d.textContent=t;convo.appendChild(d);msg.value='';var s=main.querySelector('.scroll');s.scrollTop=s.scrollHeight}
document.getElementById('send').onclick=send;
msg.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}});
document.getElementById('panel').onclick=function(){shell.classList.toggle('noright')};
document.getElementById('theme').onclick=function(){var d=r.getAttribute('data-theme')==='dark'||(!r.getAttribute('data-theme')&&matchMedia('(prefers-color-scheme:dark)').matches);r.setAttribute('data-theme',d?'light':'dark')};
})();
</script>
</body>
