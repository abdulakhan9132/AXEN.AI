<symbol id="send" viewBox="0 0 24 24" fill="currentColor"><path d="M3 11.5 21 3l-5 18-4-7z"/></symbol>
<symbol id="mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 8 9 6 9-6"/></symbol>
