<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AEXN AI</title>
<link rel="stylesheet" href="/static/css/redesign.css"><style>body{padding:0;background-image:radial-gradient(60% 45% at 50% 0%,var(--glow),transparent 70%);font-size:14px}</style>
<style>
:root{--bg:#EFECE6;--panel:rgba(255,255,255,.62);--panel2:rgba(255,255,255,.9);--line:rgba(20,20,20,.1);--ink:#141414;--mute:#625E57;--acc:#E8603A;--acc2:#D4502B;--accsoft:rgba(232,96,58,.12);--bubble:#E6DFD3;--ok:#1F7F52;--oksoft:rgba(31,127,82,.12);--glow:rgba(232,96,58,.2);--shadow:0 8px 28px rgba(40,30,20,.08);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151311;--panel:rgba(255,255,255,.05);--panel2:rgba(255,255,255,.08);--line:rgba(255,255,255,.12);--ink:#F4F1EB;--mute:#AAA59B;--accsoft:rgba(232,96,58,.2);--bubble:#2B2723;--ok:#4CC98C;--oksoft:rgba(76,201,140,.14);--glow:rgba(232,96,58,.22);--shadow:0 8px 28px rgba(0,0,0,.4)}}
:root[data-theme="dark"]{--bg:#151311;--panel:rgba(255,255,255,.05);--panel2:rgba(255,255,255,.08);--line:rgba(255,255,255,.12);--ink:#F4F1EB;--mute:#AAA59B;--accsoft:rgba(232,96,58,.2);--bubble:#2B2723;--ok:#4CC98C;--oksoft:rgba(76,201,140,.14);--glow:rgba(232,96,58,.22);--shadow:0 8px 28px rgba(0,0,0,.4)}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.5;overflow:hidden;background-image:radial-gradient(60% 45% at 50% 0%,var(--glow),transparent 70%)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
svg.i{width:18px;height:18px;flex:none}
.shell{height:100%;padding:12px;display:grid;grid-template-columns:260px minmax(0,1fr) 290px;gap:12px}
.shell.noright{grid-template-columns:260px minmax(0,1fr)}.shell.noright .right{display:none}
.glass{background:var(--panel);border:1px solid var(--line);border-radius:22px;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:var(--shadow)}
/* sidebar: whole column scrolls, nothing can be squashed */
.side{display:flex;flex-direction:column;gap:4px;padding:14px 10px 10px;overflow-y:auto;min-height:0}
.side>*{flex:none}
.brand{display:flex;align-items:center;gap:10px;padding:2px 8px 10px;font-weight:700;font-size:18px}
.logo{width:28px;height:28px;position:relative}
.logo i{position:absolute;border-radius:4px}.logo i:nth-child(1){left:0;top:10px;width:11px;height:11px;background:var(--acc)}.logo i:nth-child(2){left:9px;top:0;width:17px;height:17px;background:var(--ink);border-radius:5px}.logo i:nth-child(3){left:6px;top:22px;width:6px;height:6px;background:var(--ink)}
.new{display:flex;align-items:center;justify-content:center;gap:8px;height:42px;margin:0 2px 8px;border-radius:13px;background:var(--acc);color:#fff;font-weight:600}
.new:hover{background:var(--acc2)}
.nav button,.chat{display:flex;align-items:center;gap:11px;width:100%;height:36px;padding:0 10px;border-radius:10px;text-align:left;color:var(--mute);font-weight:500;position:relative}
.nav button:hover,.chat:hover{background:var(--accsoft);color:var(--ink)}
.nav button.on,.chat.on{background:var(--panel2);color:var(--ink)}
.nav button.on svg{color:var(--acc)}
.nav .add{margin-left:auto;width:22px;height:22px;display:grid;place-items:center;border-radius:6px;color:var(--mute)}
.chat.on::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;border-radius:3px;background:var(--acc)}
.grp{padding:14px 10px 4px;font-size:12px;font-weight:600;color:var(--mute)}
.chat span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat{color:var(--ink);font-weight:400}
.status{display:flex;align-items:center;gap:8px;margin-top:auto;padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);font-size:12.5px;font-weight:500;position:sticky;bottom:0}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);flex:none}
/* main */
.main{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden}
.top{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
.title{font-weight:600;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp{flex:1}
.pill{height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--panel2);font-weight:500;display:flex;align-items:center;gap:7px}
.pill:hover{border-color:var(--acc)}
.scroll{flex:1;min-height:0;overflow:auto;padding:24px 24px 8px}
.wrap{width:100%;max-width:740px;margin:0 auto}
.dock{padding:8px 24px 16px}
/* empty state */
.empty .scroll{display:flex;flex-direction:column;justify-content:center}
.empty .dock{display:none}
h1{font-size:clamp(26px,3.2vw,36px);line-height:1.2;font-weight:600;text-align:center;margin-bottom:20px;letter-spacing:-.02em}
.hero,.convo{display:none}
.empty .hero{display:block}.chatting .convo{display:flex}
/* composer */
.comp{border-radius:20px;border:1px solid var(--line);background:var(--panel2);padding:10px 12px;box-shadow:var(--shadow)}
.comp:focus-within{border-color:var(--acc);box-shadow:0 0 0 4px var(--accsoft)}
.comp textarea{width:100%;height:48px;resize:none;border:0;outline:0;background:none;font:inherit;color:inherit;padding:6px}
.comp textarea::placeholder{color:var(--mute)}
.crow{display:flex;align-items:center;gap:6px}
.ibtn{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:var(--mute)}
.ibtn:hover{background:var(--accsoft);color:var(--ink)}
.mode{display:flex;align-items:center;gap:6px;height:34px;padding:0 11px;border-radius:10px;border:1px solid var(--line);font-size:12.5px;font-weight:500}
.send{width:38px;height:38px;border-radius:12px;background:var(--acc);color:#fff;display:grid;place-items:center;margin-left:4px}
.send:hover{background:var(--acc2)}
.hint{text-align:center;color:var(--mute);font-size:12px;margin-top:8px}
.chips{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin:14px 0 20px}
.chip{display:flex;align-items:center;gap:7px;height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--panel);font-weight:500}
.chip:hover{border-color:var(--acc);background:var(--accsoft)}
.chip svg{color:var(--acc);width:16px;height:16px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.card{text-align:left;padding:14px;border-radius:18px;border:1px solid var(--line);background:var(--panel);min-height:112px;display:flex;flex-direction:column;gap:2px}
.card:hover{border-color:var(--acc)}
.card b{font-weight:600}.card span{color:var(--mute);font-size:12.5px}
.card svg{margin-top:auto;color:var(--acc)}
/* conversation */
.convo{flex-direction:column;gap:26px;padding-bottom:12px}
.u{align-self:flex-end;max-width:80%;background:var(--bubble);padding:10px 16px;border-radius:18px 18px 4px 18px}
.a{display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px}
.av{width:36px;height:36px;border-radius:11px;background:var(--panel2);border:1px solid var(--line);display:grid;place-items:center}
.av .logo{transform:scale(.6)}
.badge{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;background:var(--oksoft);color:var(--ok);font-size:12px;font-weight:600}
.meta{color:var(--mute);font-size:12px;margin-left:8px}
.res{margin-top:10px;padding:14px 18px;border-radius:16px;border:1px solid var(--line);background:var(--panel)}
.math{font-family:'STIX Two Text','Cambria Math',Georgia,serif;font-size:20px;line-height:1.7;overflow-x:auto;white-space:nowrap}
.math i{font-style:italic}
.math sup{font-size:.65em;line-height:0;position:relative;top:-.15em;vertical-align:super;margin-left:1px}
.math.q{font-size:15px;color:var(--mute);margin-bottom:2px}
.math.big{font-size:26px;font-weight:600}
details{margin-top:8px}
summary{cursor:pointer;color:var(--mute);font-weight:500;font-size:13px;padding:4px 0;list-style:none}
summary::before{content:"\25B8  "}details[open] summary::before{content:"\25BE  "}
.steps{margin-top:6px;padding-left:2px;display:grid;gap:4px;color:var(--ink)}
.steps .math{font-size:17px;line-height:1.6}
.acts{display:flex;gap:2px;margin-top:6px}
.acts .ibtn{width:30px;height:30px}
.acts svg{width:16px;height:16px}
/* right */
.right{display:flex;flex-direction:column;gap:10px;min-height:0;overflow:auto}
.box{padding:16px;border-radius:20px}
.box h3{font-size:13.5px;font-weight:600;margin-bottom:8px}
.box p{color:var(--mute);font-size:12.5px}
.row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-top:1px solid var(--line);font-size:13px}
.row:first-of-type{border-top:0}
.ok{color:var(--ok);font-weight:600}.off{color:var(--mute)}
.stat{display:flex;justify-content:space-between;font-size:13px;color:var(--mute);padding:2px 0}.stat b{color:var(--ink)}
@media (max-width:1100px){.shell,.shell.noright{grid-template-columns:240px minmax(0,1fr)}.right{display:none}#panel{display:none}}
@media (max-width:760px){.shell,.shell.noright{grid-template-columns:1fr;padding:6px}.side{display:none}.cards{grid-template-columns:1fr 1fr}.scroll,.dock{padding-left:14px;padding-right:14px}}
@media (prefers-reduced-motion:no-preference){.chip,.card,.nav button,.chat,.new{transition:background .15s,border-color .15s}}
</style>
</head>
<body>
